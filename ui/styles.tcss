Screen {
    background: #07111b;
    color: #d9e7f2;
}
Header {
    background: #102638;
    color: #70e1d0;
}
Footer {
    background: #102638;
}
#main {
    height: 1fr;
}
#sidebar {
    width: 27;
    min-width: 22;
    background: #0b1b29;
    border: round #1c5262;
    padding: 1;
}
#brand {
    height: 4;
    content-align: center middle;
    border-bottom: solid #1c5262;
}
#sidebar Button {
    width: 100%;
    margin: 1 0 0 0;
}
#connection {
    margin-top: 2;
    padding: 1;
    border: round #1c5262;
}
#help {
    margin-top: 1;
    color: #9cb6c8;
}
#content {
    width: 1fr;
    padding: 1;
}
#status {
    height: auto;
    max-height: 5;
    padding: 1;
    border: round #1c5262;
    background: #0b1b29;
}
#chat_area {
    height: 1fr;
    border: round #1c5262;
    margin-top: 1;
    padding: 1;
}
#chat_log {
    height: auto;
}
#composer {
    height: 3;
    margin-top: 1;
}
#prompt {
    width: 1fr;
}
#send {
    width: 12;
    margin-left: 1;
}


#globe_clock {
    height: 13;
    min-height: 13;
    width: 100%;
    margin-top: 1;
    padding: 0 1;
    border: round #1c5262;
    background: #081722;
    content-align: center middle;
    text-align: center;
}
